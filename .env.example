# ============================================================
# PataSoft env.example — Variables de Entorno (Template)
# ============================================================
# COPIA ESTE ARCHIVO a backend/.env, backend/.env.local y frontend/.env
# LUEGO reemplaza los valores con tus credenciales reales.
# NUNCA commitees credenciales reales a git (ver ADR-016).
# ============================================================

NODE_ENV=development
PORT=3000
SCALE_MODE=local

# ─── URLS DE DOMINIO ──────────────────────────────────────────
# En producción con Cloudflare Tunnel, BACKEND_URL apunta a tu dominio público
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ─── BASE DE DATOS (PostgreSQL Local) ─────────────────────────
# Usuario, contraseña y nombres de BD de tu instalación PostgreSQL local
DATABASE_URL=postgresql://patasoft:patasoft_dev@localhost:5432/patasoft_db
TEST_DATABASE_URL=postgresql://patasoft:patasoft_dev@localhost:5432/patasoft_test

# ─── SUPABASE (Producción — opcional) ─────────────────────────
# Solo si deployás a Render. En local se usa DATABASE_URL de arriba.
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DIRECT_URL=your_supabase_direct_connection_url_here

# ─── REDIS ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── AI SERVICE (Python FastAPI - Local) ──────────────────────
AI_SERVICE_URL=http://localhost:8000
AI_DEFAULT_MODEL=llama-3.3-70b-versatile
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7
AI_MEMORY_WINDOW=10

# ─── JWT ──────────────────────────────────────────────────────
# Generar con: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here_change_me
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_change_me
JWT_REFRESH_EXPIRES_IN=30d

# ─── GOOGLE OAUTH ─────────────────────────────────────────────
# Obtener en: https://console.cloud.google.com/apis/credentials
# En producción con Cloudflare Tunnel, GOOGLE_CALLBACK_URL debe apuntar
# a tu dominio público. server.sh la inyecta automáticamente.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ─── MAILJET ──────────────────────────────────────────────────
# Obtener en: https://app.mailjet.com/account/api_keys
MAILJET_API_KEY=your_mailjet_api_key_here
MAILJET_API_SECRET=your_mailjet_api_secret_here
MAILJET_FROM_EMAIL=noreply@yourdomain.com
MAILJET_FROM_NAME=PataSoft
MAILJET_SUPPORT_EMAIL=support@yourdomain.com

# ─── CLOUDINARY ───────────────────────────────────────────────
# Obtener en: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
CLOUDINARY_ROOT_FOLDER=patasoft

# ─── MERCADO PAGO ─────────────────────────────────────────────
# Obtener en: https://www.mercadopago.com/developers/panel
# IMPORTANTE: En producción se usan credenciales APP_USR (reales)
# En desarrollo/test se usan credenciales TEST (APP_USR-xxxx)
MP_ENV=sandbox
MP_APP_ID=your_mp_app_id_here
MP_USER_ID=your_mp_user_id_here
MP_CLIENT_ID=your_mp_client_id_here
MP_CLIENT_SECRET=your_mp_client_secret_here
MP_PUBLIC_KEY=your_mp_public_key_here
MP_ACCESS_TOKEN=your_mp_access_token_here
MP_REDIRECT_URI=http://localhost:3000/api/v1/mercadopago/oauth/callback
MP_PLAN_MONTHLY_PRICE=27000
MP_PLAN_YEARLY_PRICE=240000
MP_WEBHOOK_SECRET=your_mp_webhook_secret_here
MP_SUCCESS_URL=http://localhost:5173/settings/subscription?status=success
MP_FAILURE_URL=http://localhost:5173/settings/subscription?status=failure
MP_PENDING_URL=http://localhost:5173/settings/subscription?status=pending

# ─── ENCRIPTACIÓN ─────────────────────────────────────────────
# Generar con: openssl rand -hex 32 (key) / openssl rand -hex 16 (IV)
ENCRYPTION_KEY=your_encryption_key_32_bytes_hex_here
ENCRYPTION_IV=your_encryption_iv_16_bytes_hex_here

# ─── IA — APIS ────────────────────────────────────────────────
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Groq: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_DEFAULT=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# ─── PGVECTOR (Embeddings para RAG) ───────────────────────────
EMBEDDINGS_MODEL=text-embedding-004
VECTOR_DIMENSION=768

# ─── N8N (opcional — automatizaciones) ───────────────────────
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=your_n8n_api_key_here
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your_n8n_password_here
N8N_WEBHOOK_DEBT_ALERT=http://localhost:5678/webhook/debt-alert
N8N_WEBHOOK_STOCK_ALERT=http://localhost:5678/webhook/stock-alert
N8N_WEBHOOK_DOCUMENT_READY=http://localhost:5678/webhook/document-ready
N8N_WEBHOOK_WELCOME=http://localhost:5678/webhook/user-registered
N8N_WEBHOOK_SUBSCRIPTION_EXPIRING=http://localhost:5678/webhook/subscription-expiring

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── OTROS ──────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
LOG_LEVEL=debug
GUEST_SESSION_TTL=259200
TRIAL_PERIOD_DAYS=30
SUPER_ADMIN_EMAIL=admin@yourcompany.com
SUPER_ADMIN_PASSWORD=change_this_password

# ─── CLOUDFLARE TUNNEL (solo desarrollo local) ────────────────
# Necesario para Google OAuth y webhooks de MercadoPago en producción.
# Obtener token desde Cloudflare Zero Trust → Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
PUBLIC_TUNNEL_URL=https://your-tunnel-domain.com

# ─── HASHID SALT (ofuscación de IDs en URLs) ─────────────────────
# Generar con: openssl rand -hex 32
HASHID_SALT=your_hashid_salt_32_bytes_hex_here
