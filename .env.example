# ============================================
# PATASOFT - Variables de Entorno
# ============================================
# Copiar a .env y completar con valores reales
# NUNCA commitear .env con valores reales
# ============================================

# -------- ENTORNO --------
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000

# -------- BASE DE DATOS --------
DATABASE_URL=postgresql://patasoft:PASSWORD@localhost:5432/patasoft_db
REDIS_URL=redis://localhost:6379

# -------- JWT --------
# Generar con: openssl rand -base64 64
JWT_SECRET=TU_JWT_SECRET_AQUI
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=TU_JWT_REFRESH_SECRET_AQUI
JWT_REFRESH_EXPIRES_IN=30d

# -------- GOOGLE OAUTH --------
GOOGLE_CLIENT_ID=TU_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=TU_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost/api/v1/auth/google/callback

# -------- CLOUDINARY --------
CLOUDINARY_CLOUD_NAME=TU_CLOUD_NAME
CLOUDINARY_API_KEY=TU_API_KEY
CLOUDINARY_API_SECRET=TU_API_SECRET
CLOUDINARY_ROOT_FOLDER=patasoft

# -------- MAILJET --------
MAILJET_API_KEY=TU_MAILJET_API_KEY
MAILJET_API_SECRET=TU_MAILJET_API_SECRET
MAILJET_FROM_EMAIL=noreply@patasoft.app
MAILJET_FROM_NAME=PataSoft

# -------- MERCADO PAGO --------
MP_APP_ID=TU_MP_APP_ID
MP_USER_ID=TU_MP_USER_ID
MP_PUBLIC_KEY=TU_MP_PUBLIC_KEY
MP_ACCESS_TOKEN=TU_MP_ACCESS_TOKEN
MP_WEBHOOK_SECRET=PENDIENTE_CONFIGURAR
MP_ENV=sandbox
MP_REDIRECT_URI=https://tu-dominio.com/api/v1/mercadopago/oauth/callback
MP_PLAN_MONTHLY_PRICE=25000
MP_PLAN_YEARLY_PRICE=190000

# -------- OPENAI --------
OPENAI_API_KEY=TU_OPENAI_API_KEY

# -------- GOOGLE GEMINI --------
GEMINI_API_KEY=TU_GEMINI_API_KEY

# -------- GROQ --------
GROQ_API_KEY=TU_GROQ_API_KEY

# -------- SESIONES INVITADO --------
GUEST_SESSION_TTL=259200

# -------- SOCKET.IO --------
SOCKET_SECRET=TU_SOCKET_SECRET