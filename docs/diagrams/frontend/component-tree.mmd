graph TB
    subgraph "Dashboard Layout [layout.js]"
        SIDEBAR[Sidebar: Logo + Navegacion]
        TOPBAR[Topbar: Breadcrumb + NotifBell + Avatar]
        CONTENT[#page-content]
    end
    subgraph "Patron de Pagina"
        HEADER[page-header: Titulo + SearchBar + Btn Nuevo]
        TABLE[data-table: thead + tbody data-action]
        PAG_BAR[pagination]
        EMPTY[empty-state]
    end
    subgraph "Modales CRUD"
        MODAL_BOX[Modal: Overlay + Content + Botones]
        FORM[Formulario + validators.js]
        CONFIRM[onConfirm -> api.post/patch/delete -> reloadData]
    end
    subgraph "Componentes"
        M[Modal]
        T[Toast]
        SB[SearchBar]
        PG[Pagination]
        NB[NotificationBell]
    end
    SIDEBAR --> M
    TOPBAR --> NB
    CONTENT --> HEADER
    CONTENT --> TABLE
    CONTENT --> PAG_BAR
    CONTENT --> EMPTY
    HEADER --> SB
    TABLE --> MODAL_BOX
    MODAL_BOX --> FORM
    FORM --> T
