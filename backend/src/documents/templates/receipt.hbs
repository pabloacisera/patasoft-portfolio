<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <style>
    body { font-family: Arial, sans-serif; color: #222; margin: 0; padding: 0; font-size: 13px; }
    .header { padding: 24px 40px; border-bottom: 2px solid #2ecc71; }
    .company-info { margin-bottom: 16px; }
    .company-info h2 { margin: 0 0 4px; color: #2ecc71; font-size: 18px; }
    .company-info p { margin: 2px 0; font-size: 12px; color: #555; }
    .doc-type { background: #f5f5f5; padding: 12px; border-radius: 8px; text-align: center; margin: 16px 0; }
    .doc-type h3 { margin: 0; color: #333; font-size: 16px; }
    .doc-type .number { font-size: 12px; color: #666; margin-top: 4px; }
    .section { padding: 16px 40px; }
    .field-label { font-size: 11px; color: #888; }
    .field-value { font-size: 13px; font-weight: 500; }
    table { width: 100%; border-collapse: collapse; margin: 16px 0; }
    th { background: #f5f5f5; padding: 8px 12px; text-align: left; font-size: 12px; border-bottom: 2px solid #ddd; }
    td { padding: 8px 12px; border-bottom: 1px solid #eee; font-size: 13px; }
    .totals { margin-top: 16px; padding: 16px; background: #f9f9f9; border-radius: 8px; }
    .total-row { display: flex; justify-content: space-between; padding: 4px 0; }
    .total-row.final { font-weight: 700; font-size: 15px; border-top: 2px solid #333; padding-top: 8px; margin-top: 4px; }
    .footer { padding: 16px 40px; border-top: 1px solid #eee; margin-top: 16px; }
    .legal { font-size: 11px; color: #888; text-align: center; }
    .cae-box { border: 1px solid #ccc; padding: 8px 12px; margin-top: 12px; font-size: 12px; }
  </style>
</head>
<body>
  <div class="header">
    <div class="company-info">
      {{#if company.logoUrl}}<img src="{{company.logoUrl}}" height="40"><br>{{/if}}
      <h2>{{company.name}}</h2>
      <p>CUIT: {{company.cuit}} | {{company.address}}{{#if company.phone}} | Tel: {{company.phone}}{{/if}}</p>
    </div>
  </div>

  <div class="section">
    <div class="doc-type">
      <h3>COMPROBANTE INTERNO X</h3>
      <div class="number">Nº: {{paymentId}} | Fecha de emisión: {{date}}</div>
    </div>
  </div>

  <div class="section">
    <div style="margin-bottom: 12px;">
      <span class="field-label">Receptor:</span>
      <div class="field-value">{{clientName}}</div>
      <span class="field-label">DNI/CUIL:</span>
      <div class="field-value">{{clientDni}}</div>
      <span class="field-label">Dirección:</span>
      <div class="field-value">{{clientAddress}}</div>
    </div>
  </div>

  <div class="section">
    <table>
      <thead>
        <tr>
          <th>Descripción</th><th style="text-align:center;">Cant.</th><th style="text-align:right;">Precio Unit.</th><th style="text-align:right;">Subtotal</th>
        </tr>
      </thead>
      <tbody>
        {{#each items}}
        <tr>
          <td>{{description}}</td>
          <td style="text-align:center;">{{quantity}}</td>
          <td style="text-align:right;">${{unitPrice}}</td>
          <td style="text-align:right;">${{totalPrice}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  <div class="section">
    <div class="totals">
      <div class="total-row"><span>Subtotal:</span><span>${{subtotal}}</span></div>
      <div class="total-row"><span>IVA 21%:</span><span>${{iva}}</span></div>
      <div class="total-row final"><span>TOTAL:</span><span>${{total}}</span></div>
    </div>
  </div>

  <div class="footer">
    <div class="cae-box">
      <div><strong>CAE:</strong> _________ | <strong>Vto CAE:</strong> _________</div>
    </div>
    <p class="legal">Este documento no tiene validez fiscal. Uso interno.</p>
  </div>
</body>
</html>
