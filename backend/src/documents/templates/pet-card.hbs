<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: Arial, sans-serif; font-size: 12px; color: #333; }
    .header { background: #2c3e50; color: white; padding: 20px; text-align: center; }
    .header h1 { font-size: 24px; margin-bottom: 5px; }
    .header .company { font-size: 14px; opacity: 0.8; }
    .content { padding: 20px; }
    .section { margin-bottom: 20px; }
    .section h2 { 
      background: #ecf0f1; 
      padding: 8px 12px; 
      border-left: 4px solid #3498db; 
      margin-bottom: 12px;
      font-size: 14px;
    }
    .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .info-item { margin-bottom: 8px; }
    .info-label { font-weight: bold; color: #666; font-size: 10px; }
    .info-value { font-size: 12px; }
    .photo { width: 150px; height: 150px; object-fit: cover; border-radius: 8px; border: 2px solid #ecf0f1; }
    .photo-container { text-align: center; margin-bottom: 20px; }
    table { width: 100%; border-collapse: collapse; font-size: 10px; }
    th, td { border: 1px solid #ecf0f1; padding: 8px; text-align: left; }
    th { background: #f8f9fa; font-weight: bold; }
    .record { margin-bottom: 15px; page-break-inside: avoid; }
    .record-date { font-weight: bold; color: #3498db; }
    .empty { color: #999; font-style: italic; }
    .footer { 
      text-align: center; 
      padding: 15px; 
      border-top: 1px solid #ecf0f1; 
      font-size: 10px;
      color: #999;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1>🐾 Ficha de Mascota</h1>
    <div class="company">{{companyName}} - {{companyAddress}}</div>
  </div>
  
  <div class="content">
    <div class="section">
      <h2>Datos de la Mascota</h2>
      <div class="info-grid">
        <div class="photo-container">
          {{#if photoUrl}}
            <img src="{{photoUrl}}" class="photo" alt="{{petName}}">
          {{else}}
            <div class="photo" style="background:#ecf0f1;display:flex;align-items:center;justify-content:center;">Sin foto</div>
          {{/if}}
        </div>
        <div>
          <div class="info-item">
            <div class="info-label">Nombre</div>
            <div class="info-value">{{petName}}</div>
          </div>
          <div class="info-item">
            <div class="info-label">Especie</div>
            <div class="info-value">{{species}}</div>
          </div>
          <div class="info-item">
            <div class="info-label">Raza</div>
            <div class="info-value">{{breed}}</div>
          </div>
          <div class="info-item">
            <div class="info-label">Género</div>
            <div class="info-value">{{gender}}</div>
          </div>
          <div class="info-item">
            <div class="info-label">Edad</div>
            <div class="info-value">{{age}}</div>
          </div>
          <div class="info-item">
            <div class="info-label">Peso</div>
            <div class="info-value">{{weight}} kg</div>
          </div>
          <div class="info-item">
            <div class="info-label">Castrado/a</div>
            <div class="info-value">{{#if isNeutered}}Sí{{else}}No{{/if}}</div>
          </div>
        </div>
      </div>
    </div>

    <div class="section">
      <h2>Datos del Dueño</h2>
      <div class="info-grid">
        <div class="info-item">
          <div class="info-label">Nombre</div>
          <div class="info-value">{{clientName}} {{clientLastName}}</div>
        </div>
        <div class="info-item">
          <div class="info-label">Teléfono</div>
          <div class="info-value">{{clientPhone}}</div>
        </div>
        <div class="info-item">
          <div class="info-label">Email</div>
          <div class="info-value">{{clientEmail}}</div>
        </div>
      </div>
    </div>

    {{#if notes}}
    <div class="section">
      <h2>Notas</h2>
      <p>{{notes}}</p>
    </div>
    {{/if}}

    <div class="section">
      <h2>Historial Médico</h2>
      {{#if records}}
        {{#each records}}
          <div class="record">
            <div class="record-date">{{date}}</div>
            <div><strong>Motivo:</strong> {{visitReason}}</div>
            {{#if diagnosis}}<div><strong>Diagnóstico:</strong> {{diagnosis}}</div>{{/if}}
          </div>
        {{/each}}
      {{else}}
        <p class="empty">Sin historial médico registrado</p>
      {{/if}}
    </div>
  </div>

  <div class="footer">
    Documento generado {{generatedAt}}
  </div>
</body>
</html>