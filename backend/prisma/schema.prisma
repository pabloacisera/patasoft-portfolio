generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                String              @id @default(cuid())
  name              String
  slug              String              @unique
  legalName         String?
  cuit              String              @unique
  municipalLicense  String?
  address           String
  phone             String?
  email             String?
  website           String?
  logoUrl           String?
  cloudinaryFolder  String?
  animalSpecialties String[]
  isGeneral         Boolean             @default(true)
  isBlocked         Boolean             @default(false)
  blockedReason     String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  cashMovements     CashMovement[]
  clients           Client[]
  config            CompanyConfig?
  connectionsA      CompanyConnection[] @relation("CompanyA")
  connectionsB      CompanyConnection[] @relation("CompanyB")
  debts             Debt[]
  documents         Document[]
  notifications     Notification[]
  payments          Payment[]
  pets              Pet[]
  priceItems        PriceItem[]
  subscription      Subscription?
  supplies          Supply[]
  supplyPurchases   SupplyPurchase[]
  users             User[]
}

model CompanyConfig {
  id                 String   @id @default(cuid())
  companyId          String   @unique
  currency           String   @default("ARS")
  defaultAIModel     String   @default("llama-3.3-70b-versatile")
  lowStockDefaultPct Int      @default(10)
  debtAlertDays      Int[]    @default([1, 2])
  notifyEmail        Boolean  @default(true)
  notifyInApp        Boolean  @default(true)
  mpAccessToken      String?
  mpPublicKey        String?
  mpRefreshToken     String?
  onboardComplete    Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  mpNickname         String?
  mpUserId           String?
  mpAlias            String?
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String?
  name          String
  role          UserRole       @default(USER)
  googleId      String?        @unique
  avatarUrl     String?
  isActive      Boolean        @default(true)
  companyId     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]
  refreshTokens RefreshToken[]
  company       Company?       @relation(fields: [companyId], references: [id])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id               String             @id @default(cuid())
  companyId        String             @unique
  plan             SubscriptionPlan
  status           SubscriptionStatus @default(TRIAL)
  mpSubscriptionId String?
  mpPreapprovalId  String?
  startedAt        DateTime           @default(now())
  expiresAt        DateTime?
  trialEndsAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Client {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  lastName    String?
  dni         String?
  cuil        String?
  email       String?
  phone       String?
  address     String?
  isCompany   Boolean   @default(false)
  companyName String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  debts       Debt[]
  payments    Payment[]
  pets        Pet[]
}

model Pet {
  id             String          @id @default(cuid())
  companyId      String
  clientId       String?
  name           String
  species        String
  breed          String?
  gender         String?
  birthDate      DateTime?
  weight         Float?
  color          String?
  microchipId    String?
  isNeutered     Boolean         @default(false)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  medicalRecords MedicalRecord[]
  payments       Payment[]
  client         Client?         @relation(fields: [clientId], references: [id])
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  photos         PetPhoto[]
}

model PetPhoto {
  id            String   @id @default(cuid())
  petId         String
  cloudinaryUrl String
  cloudinaryId  String
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  pet           Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
}

model MedicalRecord {
  id             String         @id @default(cuid())
  petId          String
  date           DateTime       @default(now())
  visitReason    String
  diagnosis      String?
  treatment      String?
  observations   String?
  weight         Float?
  temperature    Float?
  nextVisitDate  DateTime?
  veterinarianId String?
  audioNoteUrl   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  pet            Pet            @relation(fields: [petId], references: [id], onDelete: Cascade)
  payment        Payment?
  prescriptions  Prescription[]
  procedures     Procedure[]
}

model Procedure {
  id              String        @id @default(cuid())
  medicalRecordId String
  name            String
  description     String?
  priceItemId     String?
  customPrice     Float?
  quantity        Int           @default(1)
  createdAt       DateTime      @default(now())
  supplyId        String?
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  priceItem       PriceItem?    @relation(fields: [priceItemId], references: [id])
  supply          Supply?       @relation(fields: [supplyId], references: [id])
}

model Prescription {
  id                 String        @id @default(cuid())
  medicalRecordId    String
  supplyId           String?
  medicineName       String
  dose               String?
  frequency          String?
  duration           String?
  soldInClinic       Boolean       @default(false)
  quantity           Int           @default(1)
  createdAt          DateTime      @default(now())
  dispensingQuantity Int?
  dispensingUnit     String?
  doseQuantity       Float?
  doseUnit           String?
  medicalRecord      MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  supply             Supply?       @relation(fields: [supplyId], references: [id])
}

model PriceItem {
  id          String      @id @default(cuid())
  companyId   String
  name        String
  category    String
  price       Float
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  procedures  Procedure[]
}

model PaymentItem {
  id          String   @id @default(cuid())
  paymentId   String
  description String
  quantity    Int      @default(1)
  unitPrice   Float
  totalPrice  Float
  itemType    String
  createdAt   DateTime @default(now())
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String         @id @default(cuid())
  companyId       String
  clientId        String?
  petId           String?
  medicalRecordId String?        @unique
  totalAmount     Float
  paidAmount      Float          @default(0)
  status          PaymentStatus  @default(PENDING)
  method          PaymentMethod?
  mpPaymentId     String?
  notes           String?
  dueDate         DateTime?
  paidAt          DateTime?
  cloudinaryUrl   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  cashMovements   CashMovement[] @relation("CashMovementPayment")
  debt            Debt?          @relation("DebtPayment")
  client          Client?        @relation(fields: [clientId], references: [id])
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  medicalRecord   MedicalRecord? @relation(fields: [medicalRecordId], references: [id])
  pet             Pet?           @relation(fields: [petId], references: [id])
  items           PaymentItem[]
}

model Debt {
  id             String     @id @default(cuid())
  companyId      String
  clientId       String
  paymentId      String?    @unique
  amount         Float
  status         DebtStatus @default(PENDING)
  dueDate        DateTime
  alertSent1Day  Boolean    @default(false)
  alertSent2Day  Boolean    @default(false)
  cancelledAt    DateTime?
  cancelledBy    String?
  paidAt         DateTime?
  cloudinaryUrl  String?
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?
  isDeleted      Boolean    @default(false)
  interestRate   Float?
  originalAmount Float?
  client         Client     @relation(fields: [clientId], references: [id])
  company        Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payment        Payment?   @relation("DebtPayment", fields: [paymentId], references: [id])
}

model Supply {
  id             String           @id @default(cuid())
  companyId      String
  name           String
  brand          String?
  category       String?
  unit           String?
  quantity       Int              @default(0)
  minQuantity    Int?
  initialQty     Int?
  unitPrice      Float            @default(0)
  description    String?
  expiresAt      DateTime?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  isDeleted      Boolean          @default(false)
  dispensingUnit String?
  salePrice      Float?
  stockUnit      String?
  unitsPerStock  Int?
  prescriptions  Prescription[]
  procedures     Procedure[]
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchases      SupplyPurchase[]
}

model Document {
  id              String       @id @default(cuid())
  companyId       String
  type            DocumentType
  name            String
  cloudinaryUrl   String
  cloudinaryId    String
  folder          String
  relatedEntityId String?
  relatedEntity   String?
  createdAt       DateTime     @default(now())
  deletedAt       DateTime?
  isDeleted       Boolean      @default(false)
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  companyId String
  userId    String?
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  data      Json?
  expiresAt DateTime?
  createdAt DateTime         @default(now())
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User?            @relation(fields: [userId], references: [id])
}

model CompanyConnection {
  id          String           @id @default(cuid())
  companyAId  String
  companyBId  String
  status      ConnectionStatus @default(PENDING)
  requestedBy String
  respondedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  companyA    Company          @relation("CompanyA", fields: [companyAId], references: [id])
  companyB    Company          @relation("CompanyB", fields: [companyBId], references: [id])

  @@unique([companyAId, companyBId])
}

model CashMovement {
  id        String           @id @default(cuid())
  companyId String
  type      CashMovementType
  amount    Float
  reason    String?
  paymentId String?
  createdBy String?
  date      DateTime         @default(now())
  createdAt DateTime         @default(now())
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payment   Payment?         @relation("CashMovementPayment", fields: [paymentId], references: [id])
}

model GlobalConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedBy   String?
  updatedAt   DateTime @default(now())
}

model SupplyPurchase {
  id          String   @id @default(cuid())
  companyId   String
  supplyId    String
  quantity    Int
  unitCost    Float
  totalCost   Float
  supplier    String?
  invoiceNum  String?
  notes       String?
  purchasedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supply      Supply   @relation(fields: [supplyId], references: [id], onDelete: Cascade)
}

enum UserRole {
  GUEST
  USER
  ADMIN_COMPANY
  STAFF
  SUPER_ADMIN
}

enum SubscriptionPlan {
  TRIAL
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  BLOCKED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  DEFERRED
  CANCELLED
  OVERDUE
}

enum PaymentMethod {
  CASH
  TRANSFER
  MP_QR
  MP_CHECKOUT
  CHECK
  OTHER
}

enum DebtStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum DocumentType {
  PAYMENT_RECEIPT
  DEBT_RECORD
  SUPPLY_EXCEL
  PRICE_LIST
  RAG_DOCUMENT
  EXPORT_EXCEL
  EXPORT_PDF
  ACCOUNT_STATEMENT
}

enum NotificationType {
  STOCK_LOW
  DEBT_DUE
  DEBT_OVERDUE
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  CONNECTION_REJECTED
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  MIGRATION_COMPLETE
  ONBOARDING_INCOMPLETE
  DOCUMENT_READY
  SYSTEM
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum CashMovementType {
  INCOME
  EXPENSE
}
