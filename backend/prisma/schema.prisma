generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                Int                 @id @default(autoincrement())
  name              String
  slug              String              @unique
  legalName         String?
  cuit              String              @unique
  municipalLicense  String?
  address           String
  phone             String?
  email             String?
  website           String?
  logoUrl           String?
  cloudinaryFolder  String?
  animalSpecialties String[]
  isGeneral         Boolean             @default(true)
  isBlocked         Boolean             @default(false)
  blockedReason     String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  cashMovements     CashMovement[]
  clients           Client[]
  config            CompanyConfig?
  connectionsA      CompanyConnection[] @relation("CompanyA")
  connectionsB      CompanyConnection[] @relation("CompanyB")
  debts             Debt[]
  documents         Document[]
  notifications     Notification[]
  payments          Payment[]
  pets              Pet[]
  priceItems        PriceItem[]
  subscription      Subscription?
  supplies          Supply[]
  supplyPurchases   SupplyPurchase[]
  users             User[]
}

model CompanyConfig {
  id                 Int      @id @default(autoincrement())
  companyId          Int      @unique
  currency           String   @default("ARS")
  defaultAIModel     String   @default("llama-3.3-70b-versatile")
  lowStockDefaultPct Int      @default(10)
  debtAlertDays      Int[]    @default([1, 2])
  notifyEmail        Boolean  @default(true)
  notifyInApp        Boolean  @default(true)
  mpAccessToken      String?
  mpPublicKey        String?
  mpRefreshToken     String?
  onboardComplete    Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  mpNickname         String?
  mpUserId           String?
  mpAlias            String?
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model User {
  id            Int         @id @default(autoincrement())
  email         String      @unique
  passwordHash  String?
  name          String
  role          UserRole    @default(USER)
  googleId      String?     @unique
  avatarUrl     String?
  isActive      Boolean     @default(true)
  companyId     Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  notifications Notification[]
  refreshTokens RefreshToken[]
  company       Company?    @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id               Int                @id @default(autoincrement())
  companyId        Int                @unique
  plan             SubscriptionPlan
  status           SubscriptionStatus @default(TRIAL)
  mpSubscriptionId String?
  mpPreapprovalId  String?
  startedAt        DateTime           @default(now())
  expiresAt        DateTime?
  trialEndsAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Client {
  id          Int       @id @default(autoincrement())
  companyId   Int
  name        String
  lastName    String?
  dni         String?
  cuil        String?
  email       String?
  phone       String?
  address     String?
  isCompany   Boolean   @default(false)
  companyName String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  isDeleted   Boolean   @default(false)
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  debts       Debt[]
  payments    Payment[]
  pets        Pet[]

  @@index([companyId])
  @@index([isDeleted])
  @@unique([companyId, name, lastName, cuil])
}

model Pet {
  id             Int             @id @default(autoincrement())
  companyId      Int
  clientId       Int?
  name           String
  species        String
  breed          String?
  gender         String?
  birthDate      DateTime?
  weight         Float?
  color          String?
  microchipId    String?
  isNeutered     Boolean         @default(false)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  isDeleted      Boolean         @default(false)
  medicalRecords MedicalRecord[]
  payments       Payment[]
  client         Client?         @relation(fields: [clientId], references: [id])
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  photos         PetPhoto[]

  @@index([companyId])
  @@index([isDeleted])
}

model PetPhoto {
  id            Int      @id @default(autoincrement())
  petId         Int
  cloudinaryUrl String
  cloudinaryId  String
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  pet           Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
}

model MedicalRecord {
  id               Int            @id @default(autoincrement())
  petId            Int
  date             DateTime       @default(now())
  visitReason      String
  diagnosis        String?
  treatment        String?
  observations     String?
  weight           Float?
  temperature      Float?
  nextVisitDate    DateTime?
  veterinarianId   Int?
  veterinarianName String?
  audioNoteUrl     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  isDeleted        Boolean        @default(false)
  pet              Pet            @relation(fields: [petId], references: [id], onDelete: Cascade)
  payment          Payment?
  prescriptions    Prescription[]
  procedures       Procedure[]

  @@index([petId])
  @@index([isDeleted])
}

model Procedure {
  id              Int           @id @default(autoincrement())
  medicalRecordId Int
  name            String
  description     String?
  priceItemId     Int?
  customPrice     Float?
  quantity        Int           @default(1)
  createdAt       DateTime      @default(now())
  supplyId        Int?
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  priceItem       PriceItem?    @relation(fields: [priceItemId], references: [id])
  supply          Supply?       @relation(fields: [supplyId], references: [id])
}

model Prescription {
  id                 Int           @id @default(autoincrement())
  medicalRecordId    Int
  supplyId           Int?
  medicineName       String
  dose               String?
  frequency          String?
  duration           String?
  soldInClinic       Boolean       @default(false)
  quantity           Int           @default(1)
  createdAt          DateTime      @default(now())
  dispensingQuantity Int?
  dispensingUnit     String?
  doseQuantity       Float?
  doseUnit           String?
  medicalRecord      MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  supply             Supply?       @relation(fields: [supplyId], references: [id])
}

model PriceItem {
  id          Int         @id @default(autoincrement())
  companyId   Int
  name        String
  category    String
  price       Float
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  procedures  Procedure[]
}

model PaymentItem {
  id          Int      @id @default(autoincrement())
  paymentId   Int
  description String
  quantity    Int      @default(1)
  unitPrice   Float
  totalPrice  Float
  itemType    String
  createdAt   DateTime @default(now())
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Payment {
  id              Int            @id @default(autoincrement())
  companyId       Int
  clientId        Int?
  petId           Int?
  medicalRecordId Int?           @unique
  totalAmount     Float
  paidAmount      Float          @default(0)
  status          PaymentStatus  @default(PENDING)
  method          PaymentMethod?
  mpPaymentId     String?
  notes           String?
  dueDate         DateTime?
  paidAt          DateTime?
  cloudinaryUrl   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  isDeleted       Boolean        @default(false)
  cashMovements   CashMovement[] @relation("CashMovementPayment")
  debt            Debt?          @relation("DebtPayment")
  client          Client?        @relation(fields: [clientId], references: [id])
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  medicalRecord   MedicalRecord? @relation(fields: [medicalRecordId], references: [id])
  pet             Pet?           @relation(fields: [petId], references: [id])
  items           PaymentItem[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([isDeleted])
}

model Debt {
  id             Int      @id @default(autoincrement())
  companyId      Int
  clientId       Int
  paymentId      Int?     @unique
  amount         Float
  status         DebtStatus @default(PENDING)
  dueDate        DateTime
  alertSent1Day  Boolean    @default(false)
  alertSent2Day  Boolean    @default(false)
  cancelledAt    DateTime?
  cancelledBy    Int?
  paidAt         DateTime?
  cloudinaryUrl  String?
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?
  isDeleted      Boolean    @default(false)
  interestRate   Float?
  originalAmount Float?
  client         Client     @relation(fields: [clientId], references: [id])
  company        Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payment        Payment?   @relation("DebtPayment", fields: [paymentId], references: [id])

  @@index([companyId])
  @@index([isDeleted])
}

model Supply {
  id             Int              @id @default(autoincrement())
  companyId      Int
  name           String
  brand          String?
  category       String?
  unit           String?
  quantity       Int              @default(0)
  minQuantity    Int?
  initialQty     Int?
  unitPrice      Float            @default(0)
  description    String?
  expiresAt      DateTime?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  isDeleted      Boolean          @default(false)
  dispensingUnit String?
  salePrice      Float?
  stockUnit      String?
  unitsPerStock  Int?
  prescriptions  Prescription[]
  procedures     Procedure[]
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchases      SupplyPurchase[]

  @@index([companyId])
  @@index([companyId, quantity])
  @@index([isDeleted])
}

model Document {
  id              Int          @id @default(autoincrement())
  companyId       Int
  type            DocumentType
  name            String
  cloudinaryUrl   String
  cloudinaryId    String
  folder          String
  relatedEntityId Int?
  relatedEntity   String?
  createdAt       DateTime     @default(now())
  deletedAt       DateTime?
  isDeleted       Boolean      @default(false)
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([isDeleted])
}

model Notification {
  id        Int              @id @default(autoincrement())
  companyId Int
  userId    Int?
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  data      Json?
  expiresAt DateTime?
  createdAt DateTime         @default(now())
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User?            @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([companyId, isRead])
}

model CompanyConnection {
  id          Int              @id @default(autoincrement())
  companyAId  Int
  companyBId  Int
  status      ConnectionStatus @default(PENDING)
  requestedBy Int
  respondedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  companyA    Company          @relation("CompanyA", fields: [companyAId], references: [id])
  companyB    Company          @relation("CompanyB", fields: [companyBId], references: [id])

  @@unique([companyAId, companyBId])
}

model CashMovement {
  id        Int              @id @default(autoincrement())
  companyId Int
  type      CashMovementType
  amount    Float
  reason    String?
  paymentId Int?
  createdBy Int?
  createdAt DateTime         @default(now())
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payment   Payment?         @relation("CashMovementPayment", fields: [paymentId], references: [id])

  @@index([companyId])
}

model GlobalConfig {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  updatedBy   Int?
  updatedAt   DateTime @default(now())
}

model SupplyPurchase {
  id          Int      @id @default(autoincrement())
  companyId   Int
  supplyId    Int
  quantity    Int
  unitCost    Float
  totalCost   Float
  supplier    String?
  invoiceNum  String?
  notes       String?
  purchasedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supply      Supply   @relation(fields: [supplyId], references: [id], onDelete: Cascade)
}

enum UserRole {
  GUEST
  USER
  ADMIN_COMPANY
  STAFF
  SUPER_ADMIN
}

enum SubscriptionPlan {
  TRIAL
  MONTHLY
  YEARLY
  TEST
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  BLOCKED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  DEFERRED
  CANCELLED
  OVERDUE
}

enum PaymentMethod {
  CASH
  TRANSFER
  MP_QR
  MP_CHECKOUT
  CHECK
  OTHER
}

enum DebtStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum DocumentType {
  PAYMENT_RECEIPT
  DEBT_RECORD
  SUPPLY_EXCEL
  PRICE_LIST
  RAG_DOCUMENT
  EXPORT_EXCEL
  EXPORT_PDF
  ACCOUNT_STATEMENT
}

enum NotificationType {
  STOCK_LOW
  DEBT_DUE
  DEBT_OVERDUE
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  CONNECTION_REJECTED
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  MIGRATION_COMPLETE
  ONBOARDING_INCOMPLETE
  DOCUMENT_READY
  SYSTEM
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum CashMovementType {
  INCOME
  EXPENSE
}
